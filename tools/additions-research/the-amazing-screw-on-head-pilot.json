8b5d845"}, {"name": "the-amazing-screw-on-head-pilot.thumbs/The Amazing Screw-On Head Pilot_001309.jpg", "source": "derivative", "format": "Thumbnail", "original": "The Amazing Screw-On Head Pilot.mp4", "mtime": "1762689315", "size": "25142", "md5": "dfbd226607413cabf2d3e89bdc035ddb", "crc32": "2a0e2172", "sha1": "f6c267a83ffc06f77bcee5ab050ba5a113c503c0"}, {"name": "the-amazing-screw-on-head-pilot_archive.torrent", "source": "metadata", "btih": "81ffc7ac6265333cba0277f262238400660dfa90", "mtime": "1762689462", "size": "4872", "md5": "efbf138080afbce15918f86d806f7380", "crc32": "bab3765b", "sha1": "2b954250854eedbedb1152297a75c1bd64376a3d", "format": "Archive BitTorrent"}, {"name": "the-amazing-screw-on-head-pilot_files.xml", "source": "original", "format": "Metadata", "md5": "358b089559f6cd20c2ef503fd5ec92d5", "summation": "md5"}, {"name": "the-amazing-screw-on-head-pilot_meta.sqlite", "source": "original", "mtime": "1762689222", "size": "28672", "md5": "8674bf913377b2384748cc866f22668b", "crc32": "427bd33b", "sha1": "f5d82144f65c91953f837ff6369cb5e66cd27f2a", "format": "Metadata"}, {"name": "the-amazing-screw-on-head-pilot_meta.xml", "source": "original", "mtime": "1762689237", "size": "2686", "md5": "1f28d0e529c0c76856260c1992d0ad22", "crc32": "a4fce790", "sha1": "a9d4838b66624e31ffa7cf77d49a7d4864cf8d7b", "format": "Metadata"}], "files_count": 28, "item_last_updated": 1762689465, "item_size": 75978752, "metadata": {"identifier": "the-amazing-screw-on-head-pilot", "mediatype": "movies", "collection": "opensource_movies", "date": "2025-11-09", "description": "The\u00a0<span class=\"Yjhzub\" style=\"font-weight:700;color:rgb(10,10,10);font-family:'Google Sans', Roboto, Arial, sans-serif;font-size:16px;background-color:rgb(255,255,255);\"><em class=\"eujQNb\" style=\"font-weight:inherit;\">Amazing Screw-On Head</em>\u00a0pilot</span><span style=\"color:rgb(10,10,10);font-family:'Google Sans', Roboto, Arial, sans-serif;font-size:16px;background-color:rgb(255,255,255);\">\u00a0is\u00a0</span>a single, 22-minute animated television episode produced for the Sci-Fi Channel (now Syfy) in 2006, based on the one-shot comic book by\u00a0<em class=\"eujQNb\" style=\"font-weight:inherit;\">Hellboy</em>\u00a0creator Mike Mignola<span style=\"color:rgb(10,10,10);font-family:'Google Sans', Roboto, Arial, sans-serif;font-size:16px;background-color:rgb(255,255,255);\">. It was written and executive produced by Bryan Fuller and directed by Chris Prynoski\u00a0</span><div><span style=\"color:rgb(10,10,10);font-family:'Google Sans', Roboto, Arial, sans-serif;font-size:16px;background-color:rgb(255,255,255);\"><br /></span></div><div><ul class=\"KsbFXc U6u95\" style=\"margin:16px 0px;padding:0px;font-family:'Google Sans', Roboto, Arial, sans-serif;font-size:16px;line-height:24px;color:rgb(10,10,10);background-color:rgb(255,255,255);\"><li style=\"margin:0px 0px 16px;padding:0px;list-style:disc;\"><span class=\"T286Pc\"><span class=\"Yjhzub\" style=\"font-weight:700;\">Plot:</span>\u00a0The pilot follows the adventures of the title character, a secret agent who is a mechanical head capable of being attached to various robotic bodies, each with different abilities. He serves under President Abraham Lincoln and is tasked with stopping his nefarious nemesis, the undead occultist Emperor Zombie. In the pilot, Emperor Zombie attempts to gain power from a demigod trapped inside a turnip.</span></li></ul></div>", "licenseurl": "https://creativecommons.org/licenses/by-nd/4.0/", "scanner": "Internet Archive HTML5 Uploader 1.7.0", "subject": "animation", "title": "The Amazing Screw On Head Pilot", "uploader": "madspiralvideo004@gmail.com", "publicdate": "2025-11-09 11:53:28", "addeddate": "2025-11-09 11:53:28", "curation": "[curator]validator@archive.org[/curator][date]20251109115357[/date][comment]checked for malware[/comment]"}, "server": "ia800504.us.archive.org", "servers_unavailable": true, "uniq": 1904144318, "workable_servers": ["ia800504.us.archive.org"]}